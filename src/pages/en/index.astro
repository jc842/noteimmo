---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog-en');
---

<Layout title="Note Immo — Real Estate Market Indices & Valuation Barometer" lang="en">
  <section class="border-b border-slate-800 bg-slate-950 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/30 bg-blue-950/40 px-3.5 py-1 font-mono text-xs text-blue-300 mb-4">
        INTERNATIONAL INVESTOR HUB
      </div>
      <h1 class="text-3xl font-extrabold text-white sm:text-5xl">Caribbean Real Estate Valuation Intelligence</h1>
      <p class="mt-4 max-w-2xl text-slate-300 text-sm sm:text-base leading-relaxed">
        Objective market multiples, notary due diligence guides, and investment yield benchmarks for the French Caribbean.
      </p>
    </div>
  </section>

  <section class="py-12 bg-slate-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map(post => (
          <article class="flex flex-col justify-between rounded-xl border border-slate-800 bg-slate-900/50 p-6 hover:border-blue-500/50 transition-colors">
            <div>
              <span class="rounded bg-slate-800 px-2 py-0.5 font-mono text-[11px] text-blue-400 font-semibold">{post.data.category}</span>
              <h2 class="text-lg font-bold text-white mt-3 hover:text-blue-400 transition-colors">
                <a href={'/en/' + post.id + '/'}>{post.data.title}</a>
              </h2>
              <p class="mt-2 text-xs text-slate-400 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-800 font-mono text-xs">
              <a href={'/en/' + post.id + '/'} class="text-blue-400 hover:underline">Read Analysis →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
