---
import ReviveSlot from '../../components/ads/ReviveSlot.astro';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title + ' — Note Immo'} description={post.data.description}>
  <article class="py-12 bg-slate-950">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      
      <!-- Breadcrumb & Metadata -->
      <div class="flex items-center gap-2 font-mono text-xs text-slate-400 mb-6">
        <a href="/" class="hover:text-blue-400">Accueil</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-blue-400">Analyses</a>
        <span>/</span>
        <span class="text-blue-400">{post.data.category || 'Article'}</span>
      </div>

      <!-- Header -->
      <header class="border-b border-slate-800 pb-8 mb-8">
        <div class="inline-block rounded bg-blue-950 border border-blue-800/60 px-2.5 py-1 font-mono text-xs text-blue-300 font-semibold mb-4">
          RAPPORT OFFICIEL NOTE IMMO
        </div>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
          {post.data.title}
        </h1>
        <div class="mt-4 flex items-center gap-4 font-mono text-xs text-slate-400">
          <span>Publié le {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          <span>•</span>
          <span>Observatoire Note Immo</span>
        </div>
      </header>

      <!-- Content -->
      <div class="prose prose-invert prose-slate max-w-none prose-headings:font-bold prose-headings:text-white prose-a:text-blue-400 prose-code:font-mono prose-code:text-cyan-300 leading-relaxed text-slate-300">
        <Content />

      <!-- Encart Pub In-Content Revive (Medium Rectangle) -->
      <div class="my-12 py-6 border-y border-stone-200/80 dark:border-stone-800 flex justify-center">
        <ReviveSlot slot="inContent" />
      </div>

      <!-- Encart Pub Fin d'Article Large Rectangle -->
      <div class="my-8 p-4 bg-stone-50/60 dark:bg-stone-900/60 rounded-2xl border border-stone-200/60 dark:border-stone-800 flex flex-col items-center justify-center text-center">
        <ReviveSlot slot="largeRectangle" />
      </div>
      </div>

      <!-- Post Footer -->
      <footer class="mt-12 border-t border-slate-800 pt-8 font-mono text-xs flex justify-between items-center text-slate-400">
        <a href="/blog/" class="text-blue-400 hover:underline">← Retour aux analyses</a>
        <span>Note Immo Intelligence</span>
      </footer>
    </div>
  </article>
</Layout>
