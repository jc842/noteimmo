---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<Layout title="Baromètre & Analyses Immobilières — Note Immo">
  <section class="border-b border-slate-800 bg-slate-950 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/30 bg-blue-950/40 px-3 py-1 font-mono text-xs text-blue-300 mb-4">
        INDEX DES PUBLICATIONS
      </div>
      <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Tous les Rapports et Études de Marché</h1>
      <p class="mt-3 max-w-2xl text-slate-400 text-sm">
        Explorez l'intégralité de nos analyses de valorisation, baromètres de prix et guides juridiques fonciers.
      </p>
    </div>
  </section>

  <section class="py-12 bg-slate-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPosts.map(post => (
          <article class="flex flex-col justify-between rounded-xl border border-slate-800 bg-slate-900/50 p-6 hover:border-blue-500/50 transition-colors">
            <div>
              <div class="flex items-center justify-between font-mono text-[11px] text-slate-400 mb-3">
                <span class="rounded bg-slate-800 px-2 py-0.5 text-blue-400 font-semibold">{post.data.category || 'Étude'}</span>
                <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              </div>
              <h2 class="text-base font-bold text-white hover:text-blue-400 transition-colors line-clamp-2">
                <a href={'/blog/' + post.id + '/'}>{post.data.title}</a>
              </h2>
              <p class="mt-2 text-xs text-slate-400 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-slate-800 flex justify-end font-mono text-xs">
              <a href={'/blog/' + post.id + '/'} class="text-blue-400 hover:underline">
                Consulter l'analyse →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
