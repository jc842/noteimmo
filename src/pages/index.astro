---
import ReviveSlot from '../components/ads/ReviveSlot.astro';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
const featuredPosts = sortedPosts.slice(0, 6);
const remainingPosts = sortedPosts.slice(6);
---

<Layout title="Note Immo — Observatoire de la Valeur et Indices Immobiliers">
  <!-- Hero Section Simplexity -->
  <section class="relative border-b border-slate-800 bg-slate-950 py-16 sm:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(37,99,235,0.15),rgba(255,255,255,0))]"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      
      <!-- Top Pill -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-blue-500/30 bg-blue-950/40 px-3.5 py-1.5 font-mono text-xs text-blue-300">
        <span class="h-2 w-2 rounded-full bg-blue-400 animate-ping"></span>
        OBSERVATOIRE INDÉPENDANT DU MARCHÉ IMMOBILIER
      </div>

      <!-- Headline -->
      <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl max-w-4xl leading-tight">
        L'Indice de Référence et d'Évaluation de la <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">Valeur Immobilière</span>.
      </h1>

      <p class="mt-6 max-w-2xl text-base sm:text-lg text-slate-300 leading-relaxed">
        Analyses notariales, ratios de capitalisation, baromètres de décotes territoriales et veille juridique pour éclairer les décisions d'acquisition et d'arbitrage.
      </p>

      <!-- Key Metrics Row -->
      <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:gap-6 font-mono">
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 backdrop-blur-sm">
          <div class="text-[11px] text-slate-400 uppercase tracking-wider">Score Liquidité Moyen</div>
          <div class="mt-1 text-2xl font-bold text-blue-400">AA+</div>
          <div class="mt-1 text-[11px] text-emerald-400 font-sans">Marché insulaire tendu</div>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 backdrop-blur-sm">
          <div class="text-[11px] text-slate-400 uppercase tracking-wider">Délai Vente Médian</div>
          <div class="mt-1 text-2xl font-bold text-white">82 j</div>
          <div class="mt-1 text-[11px] text-slate-400 font-sans">-5 jours vs 2024</div>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 backdrop-blur-sm">
          <div class="text-[11px] text-slate-400 uppercase tracking-wider">Rendement Brut Moyen</div>
          <div class="mt-1 text-2xl font-bold text-cyan-400">6.8%</div>
          <div class="mt-1 text-[11px] text-emerald-400 font-sans">Villas & appartements</div>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 backdrop-blur-sm">
          <div class="text-[11px] text-slate-400 uppercase tracking-wider">Règlements & Notaires</div>
          <div class="mt-1 text-2xl font-bold text-white">100%</div>
          <div class="mt-1 text-[11px] text-slate-400 font-sans">Sécurisation titre foncier</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Analysis Bento Grid -->
  <section class="py-16 sm:py-20 bg-slate-950 border-b border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex items-center justify-between mb-10">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-blue-400">Baromètre d'Experts</span>
          <h2 class="text-2xl font-bold text-white sm:text-3xl mt-1">Dernières Analyses et Fiches Pratiques</h2>
        </div>
        <a href="/blog/" class="hidden sm:inline-flex items-center gap-2 font-mono text-xs text-blue-400 hover:text-blue-300">
          VOIR TOUS LES RAPPORTS →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredPosts.map((post, idx) => (
          <article class="group relative flex flex-col justify-between rounded-xl border border-slate-800 bg-slate-900/40 p-6 transition-all duration-300 hover:border-blue-500/50 hover:bg-slate-900/80">
            <div>
              <div class="flex items-center justify-between font-mono text-[11px] text-slate-400 mb-3">
                <span class="rounded bg-slate-800 px-2 py-0.5 text-blue-400 font-semibold">{post.data.category || 'Étude'}</span>
                <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-blue-400 transition-colors line-clamp-2 leading-snug">
                <a href={'/blog/' + post.id + '/'}>
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-3 text-xs text-slate-400 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between font-mono text-xs">
              <span class="text-slate-500">Réf. NOTE-0{idx + 1}</span>
              <a href={'/blog/' + post.id + '/'} class="text-blue-400 hover:underline flex items-center gap-1">
                Lire l'analyse →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Complete Archive Grid -->
  {remainingPosts.length > 0 && (
    <section class="py-16 bg-slate-900/20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <h2 class="text-xl font-bold text-white mb-8 font-mono text-sm tracking-wider uppercase text-slate-300">
          Archives et Dossiers Fonciers
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {remainingPosts.map(post => (
            <div class="flex items-start justify-between rounded-lg border border-slate-800 bg-slate-900/50 p-4 hover:border-slate-700 transition-colors">
              <div class="pr-4">
                <span class="font-mono text-[10px] text-blue-400 uppercase tracking-wider">{post.data.category || 'Dossier'}</span>
                <h4 class="text-sm font-semibold text-white mt-1 hover:text-blue-300 transition-colors">
                  <a href={'/blog/' + post.id + '/'}>{post.data.title}</a>
                </h4>
              </div>
              <a href={'/blog/' + post.id + '/'} class="font-mono text-xs text-blue-400 whitespace-nowrap pt-1">
                Consulter →
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
  <!-- Emplacement Publicitaire Revive In-Content -->
  <div class="my-14 flex justify-center">
    <ReviveSlot slot="inContent" />
  </div>
</Layout>
