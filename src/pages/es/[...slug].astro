---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog-es');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title + ' — Note Immo'} description={post.data.description} lang="es">
  <article class="py-12 bg-slate-950">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="flex items-center gap-2 font-mono text-xs text-slate-400 mb-6">
        <a href="/es/" class="hover:text-blue-400">Edición en Español</a>
        <span>/</span>
        <span class="text-blue-400">{post.data.category}</span>
      </div>
      <header class="border-b border-slate-800 pb-8 mb-8">
        <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
          {post.data.title}
        </h1>
        <p class="mt-3 font-mono text-xs text-slate-400">Observatorio Note Immo — Inteligencia Inmobiliaria</p>
      </header>
      <div class="prose prose-invert prose-slate max-w-none prose-headings:font-bold prose-headings:text-white prose-a:text-blue-400 prose-code:font-mono prose-code:text-cyan-300 leading-relaxed text-slate-300">
        <Content />
      </div>
      <footer class="mt-12 border-t border-slate-800 pt-8 font-mono text-xs text-slate-400">
        <a href="/es/" class="text-blue-400 hover:underline">← Volver a los estudios</a>
      </footer>
    </div>
  </article>
</Layout>
